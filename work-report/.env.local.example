# ── Supabase (morning-brief와 다른 새 프로젝트를 만드세요) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# 서버(cron·드라이브 업로드)에서만 사용. 절대 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── 구글 드라이브 저장 ──
# 서비스 계정을 만들고, 저장할 드라이브 폴더를 그 계정 이메일에 "편집자"로 공유하세요.
GOOGLE_SERVICE_ACCOUNT_EMAIL=work-report@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=드라이브_폴더_ID
# 공유 드라이브(팀 드라이브)에 저장할 때만 필요
GOOGLE_DRIVE_ID=

# ── 자동 생성 cron 보호용 (Vercel Cron이 헤더로 보냄) ──
CRON_SECRET=아무_긴_임의_문자열
